# Firebase Configuration - Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Gemini is configured server-side as the Firebase Functions secret GEMINI_API_KEY.
# Never add a Gemini API key to this file or to a VITE_* variable.

# Local Cloudflare Media Worker. Keep this on localhost until deployment is approved.
VITE_MEDIA_WORKER_URL=http://localhost:8787

# GIPHY public client API key (GIPHY requires search requests from the client).
# This key is visible in the browser bundle; use a dedicated CampusFind key.
VITE_GIPHY_API_KEY=your_giphy_api_key_here

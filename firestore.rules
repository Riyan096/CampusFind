rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function validItemType(t) {
      return t in ['LOST', 'FOUND'];
    }

    function validCategory(c) {
      return c in ['Electronics', 'Clothing', 'Keys', 'ID Cards', 'Books', 'Other'];
    }

    function validStatusForType(t, s) {
      return (t == 'LOST' && s in ['STILL_LOST', 'MATCH_FOUND', 'CLAIMED', 'RECOVERED']) ||
        (t == 'FOUND' && s in ['AVAILABLE', 'PENDING_CLAIM', 'RETURNED', 'UNCLAIMED']);
    }

    function validItemImageUrl(d) {
      return !('imageUrl' in d) ||
        (d.imageUrl is string &&
          d.imageUrl.size() <= 2000 &&
          !d.imageUrl.matches('data:.*'));
    }

    function validItemCreate() {
      let d = request.resource.data;
      return d.reportedBy == request.auth.uid &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
        d.description is string && d.description.size() <= 8000 &&
        d.location is string && d.location.size() <= 300 &&
        validItemType(d.type) && validCategory(d.category) &&
        validStatusForType(d.type, d.status) &&
        validItemImageUrl(d);
    }

    function validItemUpdate() {
      let d = request.resource.data;
      let before = resource.data;
      return d.diff(before).affectedKeys().hasOnly([
          'title',
          'description',
          'category',
          'location',
          'latlng',
          'imageUrl',
          'aiTags',
          'reporterName',
          'updatedAt'
        ]) &&
        d.reportedBy == before.reportedBy &&
        d.type == before.type &&
        d.status == before.status &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
        d.description is string && d.description.size() <= 8000 &&
        d.location is string && d.location.size() <= 300 &&
        validItemType(d.type) && validCategory(d.category) &&
        validStatusForType(d.type, d.status) &&
        validItemImageUrl(d);
    }

    function validNotificationCreate() {
      let d = request.resource.data;
      return d.userId is string &&
        exists(/databases/$(database)/documents/users/$(d.userId)) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
        d.message is string && d.message.size() <= 4000 &&
        d.type in ['item_match', 'chat_message', 'status_update', 'system'] &&
        d.read == false;
    }

    function validPublicProfile() {
      let d = request.resource.data;
      let privateUser = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return d.uid == request.auth.uid &&
        d.displayName is string && d.displayName.size() <= 100 &&
        (d.photoURL == null || d.photoURL is string) &&
        d.points == privateUser.points &&
        d.itemsReported == privateUser.itemsReported &&
        d.itemsReturned == privateUser.itemsReturned &&
        d.itemsClaimed == privateUser.itemsClaimed;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.isAdmin == false;

      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          request.resource.data.isAdmin == resource.data.isAdmin &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'photoURL',
            'profileStoragePath',
            'phone',
            'bio',
            'updatedAt'
          ]) &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100 &&
          (request.resource.data.photoURL == null || request.resource.data.photoURL is string) &&
          (request.resource.data.profileStoragePath == null ||
            request.resource.data.profileStoragePath is string) &&
          (request.resource.data.phone == null ||
            (request.resource.data.phone is string && request.resource.data.phone.size() <= 32)) &&
          (request.resource.data.bio == null ||
            (request.resource.data.bio is string && request.resource.data.bio.size() <= 2000)) &&
          (request.resource.data.updatedAt == null ||
            request.resource.data.updatedAt is string)
        ) ||
        (isAdmin() && request.auth.uid != userId)
      );

      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isAdmin();
        allow update: if isSignedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /pointAwards/{awardId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'points',
          'itemsReported',
          'itemsReturned',
          'itemsClaimed'
        ]) &&
        validPublicProfile();
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'points',
          'itemsReported',
          'itemsReturned',
          'itemsClaimed'
        ]) &&
        request.resource.data.uid == resource.data.uid &&
        validPublicProfile();
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && validItemCreate();
      allow update: if isSignedIn() &&
        (resource.data.reportedBy == request.auth.uid || isAdmin()) &&
        validItemUpdate();
      allow delete: if isSignedIn() &&
        (resource.data.reportedBy == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validNotificationCreate();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /adminSettings/{document} {
      allow read, write: if isAdmin();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function validItemType(t) {
      return t in ['LOST', 'FOUND'];
    }

    function validCategory(c) {
      return c in ['Electronics', 'Clothing', 'Keys', 'ID Cards', 'Books', 'Other'];
    }

    function validStatusForType(t, s) {
      return (t == 'LOST' && s in ['STILL_LOST', 'MATCH_FOUND', 'CLAIMED', 'RECOVERED']) ||
        (t == 'FOUND' && s in ['AVAILABLE', 'PENDING_CLAIM', 'RETURNED', 'UNCLAIMED']);
    }

    function validItemImageUrl(d) {
      return !('imageUrl' in d) ||
        (d.imageUrl is string &&
          d.imageUrl.size() <= 2000 &&
          !d.imageUrl.matches('data:.*'));
    }

    function validInitialItemStatus(t, s) {
      return (t == 'LOST' && s == 'STILL_LOST') ||
        (t == 'FOUND' && s == 'AVAILABLE');
    }

    function validItemTags(d) {
      return !('aiTags' in d) ||
        (d.aiTags is list && d.aiTags.size() <= 10);
    }

    function validItemCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'reportedBy', 'type', 'status', 'title', 'description', 'category',
          'location', 'date', 'latlng', 'imageUrl', 'aiTags', 'reporterName',
          'createdAt', 'updatedAt'
        ]) &&
        d.reportedBy == request.auth.uid &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
        d.description is string && d.description.size() <= 8000 &&
        d.location is string && d.location.size() <= 300 &&
        validItemType(d.type) && validCategory(d.category) &&
        validInitialItemStatus(d.type, d.status) &&
        d.date is string && d.date.size() <= 64 &&
        (!('reporterName' in d) ||
          (d.reporterName is string && d.reporterName.size() <= 100)) &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        validItemTags(d) &&
        validItemImageUrl(d);
    }

    function validItemUpdate() {
      let d = request.resource.data;
      let before = resource.data;
      return d.diff(before).affectedKeys().hasOnly([
          'title',
          'description',
          'category',
          'location',
          'latlng',
          'imageUrl',
          'aiTags',
          'reporterName',
          'updatedAt'
        ]) &&
        d.reportedBy == before.reportedBy &&
        d.type == before.type &&
        d.status == before.status &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
        d.description is string && d.description.size() <= 8000 &&
        d.location is string && d.location.size() <= 300 &&
        validItemType(d.type) && validCategory(d.category) &&
        validStatusForType(d.type, d.status) &&
        (!('reporterName' in d) ||
          (d.reporterName is string && d.reporterName.size() <= 100)) &&
        (!d.diff(before).affectedKeys().hasAny(['updatedAt']) ||
          d.updatedAt == request.time) && validItemTags(d) &&
        validItemImageUrl(d);
    }

    function validPublicProfile() {
      let d = request.resource.data;
      let privateUser = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return d.uid == request.auth.uid &&
        d.displayName is string && d.displayName.size() <= 100 &&
        (d.photoURL == null || d.photoURL is string) &&
        d.points == privateUser.points &&
        d.itemsReported == privateUser.itemsReported &&
        d.itemsReturned == privateUser.itemsReturned &&
        d.itemsClaimed == privateUser.itemsClaimed;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'isAdmin', 'createdAt',
          'points', 'itemsReturned', 'itemsReported', 'itemsClaimed'
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.isAdmin == false &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.createdAt is string &&
        request.resource.data.points == 0 &&
        request.resource.data.itemsReturned == 0 &&
        request.resource.data.itemsReported == 0 &&
        request.resource.data.itemsClaimed == 0 &&
        (!('email' in request.resource.data) ||
          (request.resource.data.email is string &&
            request.resource.data.email.size() <= 254));

      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          request.resource.data.isAdmin == resource.data.isAdmin &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'photoURL',
            'profileStoragePath',
            'phone',
            'bio',
            'updatedAt'
          ]) &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100 &&
          (request.resource.data.get('photoURL', null) == null ||
            request.resource.data.get('photoURL', null) is string) &&
          (request.resource.data.get('profileStoragePath', null) == null ||
            request.resource.data.get('profileStoragePath', null) is string) &&
          (request.resource.data.get('phone', null) == null ||
            (request.resource.data.get('phone', null) is string &&
              request.resource.data.get('phone', null).size() <= 32)) &&
          (request.resource.data.get('bio', null) == null ||
            (request.resource.data.get('bio', null) is string &&
              request.resource.data.get('bio', null).size() <= 2000)) &&
          (request.resource.data.get('updatedAt', null) == null ||
            request.resource.data.get('updatedAt', null) is string)
        ) ||
        (isAdmin() && request.auth.uid != userId)
      );

      allow delete: if isAdmin();

      match /blockedUsers/{blockedUserId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
          blockedUserId != userId &&
          request.resource.data.keys().hasOnly(['blockedUserId', 'createdAt']) &&
          request.resource.data.blockedUserId == blockedUserId &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isAdmin();
        allow update: if isSignedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /pointAwards/{awardId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'points',
          'itemsReported',
          'itemsReturned',
          'itemsClaimed'
        ]) &&
        validPublicProfile();
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'points',
          'itemsReported',
          'itemsReturned',
          'itemsClaimed'
        ]) &&
        request.resource.data.uid == resource.data.uid &&
        validPublicProfile();
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && validItemCreate();
      allow update: if isSignedIn() &&
        (resource.data.reportedBy == request.auth.uid || isAdmin()) &&
        validItemUpdate();
      allow delete: if isSignedIn() &&
        (resource.data.reportedBy == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Notifications are written by trusted Functions after verifying the
      // originating item/chat event. Clients may only mark their own as read.
      function validChatMessageNotification() {
        let d = request.resource.data;
        let chatPath = /databases/$(database)/documents/chats/$(d.relatedChatId);
        let messagePath = /databases/$(database)/documents/chats/$(d.relatedChatId)/messages/$(d.relatedMessageId);
        return d.keys().hasOnly([
            'userId', 'title', 'message', 'type', 'read', 'createdAt',
            'relatedItemId', 'relatedChatId', 'relatedMessageId'
          ]) &&
          d.userId is string &&
          d.userId != request.auth.uid &&
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(d.userId)) &&
          !exists(/databases/$(database)/documents/users/$(d.userId)/blockedUsers/$(request.auth.uid)) &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
          d.message is string && d.message.size() <= 120 &&
          d.type == 'chat_message' &&
          d.read == false &&
          d.createdAt == request.time &&
          d.relatedChatId is string &&
          d.relatedMessageId is string &&
          d.relatedItemId is string &&
          exists(chatPath) &&
          request.auth.uid in get(chatPath).data.participantIds &&
          d.userId in get(chatPath).data.participantIds &&
          get(chatPath).data.itemId == d.relatedItemId &&
          exists(messagePath) &&
          get(messagePath).data.senderId == request.auth.uid &&
          get(messagePath).data.content is string &&
          get(messagePath).data.content.size() > 0;
      }

      allow create: if (
        isAdmin() &&
        request.resource.data.keys().hasOnly([
          'title', 'message', 'type', 'recipientCount', 'sentBy',
          'sentByName', 'createdAt', 'isGlobal'
        ]) &&
        request.resource.data.isGlobal == true &&
        request.resource.data.sentBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 4000 &&
        request.resource.data.type in ['info', 'success', 'warning'] &&
        request.resource.data.recipientCount is int &&
        request.resource.data.recipientCount >= 0 &&
        request.resource.data.sentByName is string &&
        request.resource.data.sentByName.size() <= 100 &&
        request.resource.data.createdAt == request.time
      ) || (
        isSignedIn() && validChatMessageNotification()
      );
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }


    // User reports are private to the reporter and authorized admins.
    match /userReports/{reportId} {
      function validReportCreate() {
        let d = request.resource.data;
        let chatPath = /databases/$(database)/documents/chats/$(d.chatId);
        return isSignedIn() &&
          d.keys().hasOnly([
            'reporterId', 'reportedUserId', 'chatId', 'itemId',
            'reason', 'details', 'status', 'createdAt', 'updatedAt'
          ]) &&
          d.reporterId == request.auth.uid &&
          d.reportedUserId is string &&
          d.reportedUserId != request.auth.uid &&
          d.chatId is string &&
          d.itemId is string &&
          exists(chatPath) &&
          get(chatPath).data.itemId == d.itemId &&
          get(chatPath).data.participantIds.hasAll([d.reporterId, d.reportedUserId]) &&
          d.reason in [
            'harassment', 'threats', 'spam', 'impersonation',
            'inappropriate_content', 'scam', 'other'
          ] &&
          d.details is string &&
          d.details.size() <= 1000 &&
          d.status == 'new' &&
          d.createdAt == request.time &&
          d.updatedAt == request.time;
      }

      allow create: if validReportCreate();
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['reviewing', 'actioned', 'dismissed'] &&
        request.resource.data.reviewNote is string &&
        request.resource.data.reviewNote.size() <= 1000 &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Firestore chat: users can discover only chats whose participantIds include them.
    match /chats/{chatId} {
      function isChatParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }

      function hasBlockBetween(userA, userB) {
        return exists(/databases/$(database)/documents/users/$(userA)/blockedUsers/$(userB)) ||
          exists(/databases/$(database)/documents/users/$(userB)/blockedUsers/$(userA));
      }

      function validChatCreate() {
        let itemPath = /databases/$(database)/documents/items/$(request.resource.data.itemId);
        return isSignedIn() &&
          request.resource.data.keys().hasOnly([
            'itemId', 'itemTitle', 'createdBy', 'participantIds',
            'participants', 'createdAt'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.itemId is string &&
          request.resource.data.itemTitle is string &&
          request.resource.data.itemTitle.size() > 0 &&
          request.resource.data.itemTitle.size() <= 200 &&
          exists(itemPath) &&
          get(itemPath).data.reportedBy is string &&
          get(itemPath).data.reportedBy != request.auth.uid &&
          !hasBlockBetween(request.auth.uid, get(itemPath).data.reportedBy) &&
          request.resource.data.itemTitle == get(itemPath).data.title &&
          request.resource.data.participantIds is list &&
          request.resource.data.participantIds.size() == 2 &&
          request.resource.data.participantIds.hasAll([
            request.auth.uid, get(itemPath).data.reportedBy
          ]) &&
          request.resource.data.participants.keys().hasAll([
            request.auth.uid, get(itemPath).data.reportedBy
          ]) &&
          request.resource.data.participants.keys().hasOnly([
            request.auth.uid, get(itemPath).data.reportedBy
          ]) &&
          request.resource.data.createdAt == request.time;
      }

      allow read: if isChatParticipant();
      allow create: if validChatCreate();
      function validChatUserSettingsUpdate() {
        let changedUsers = request.resource.data.userSettings
          .diff(resource.data.get('userSettings', {})).affectedKeys();
        let settings = request.resource.data.userSettings[request.auth.uid];
        return changedUsers.hasOnly([request.auth.uid]) &&
          settings is map &&
          settings.keys().hasOnly(['pinned', 'muted', 'archived']) &&
          (!('pinned' in settings) || settings.pinned is bool) &&
          (!('muted' in settings) || settings.muted is bool) &&
          (!('archived' in settings) || settings.archived is bool);
      }

      allow update: if isChatParticipant() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userSettings']) &&
          validChatUserSettingsUpdate()
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt']) &&
          request.resource.data.lastReadAt is map &&
          request.resource.data.lastReadAt.diff(resource.data.get('lastReadAt', {}))
            .affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.lastReadAt[request.auth.uid] == request.time
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage']) &&
          request.resource.data.lastMessage.keys().hasOnly(['content', 'timestamp', 'senderId']) &&
          request.resource.data.lastMessage.senderId == request.auth.uid &&
          request.resource.data.lastMessage.content is string &&
          request.resource.data.lastMessage.content.size() <= 100 &&
          request.resource.data.lastMessage.timestamp == request.time
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'participantIds', 'participants'
          ]) &&
          resource.data.participantIds.hasAll(request.resource.data.participantIds) &&
          request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1 &&
          !(request.auth.uid in request.resource.data.participantIds) &&
          request.resource.data.participants.diff(resource.data.participants)
            .removedKeys().hasOnly([request.auth.uid])
        )
      );
      allow delete: if isChatParticipant() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function isParentParticipant() {
          return isSignedIn() && request.auth.uid in parentChat().participantIds;
        }

        function isBlockedBetweenParticipants() {
          let participants = parentChat().participantIds;
          let otherUserId = participants.size() == 2
            ? (participants[0] == request.auth.uid ? participants[1] : participants[0])
            : '';
          return participants.size() == 2 &&
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(otherUserId)) ||
            exists(/databases/$(database)/documents/users/$(otherUserId)/blockedUsers/$(request.auth.uid)));
        }

        function validImageAttachment() {
          let attachment = request.resource.data.attachment;
          return attachment is map &&
            attachment.keys().hasOnly(['type', 'publicId', 'format', 'bytes', 'width', 'height']) &&
            attachment.type == 'image' &&
            attachment.publicId is string &&
            attachment.publicId.matches('campusfind/chats/' + chatId + '/[A-Za-z0-9-]{36}') &&
            attachment.format in ['jpg', 'png', 'webp'] &&
            attachment.bytes is int && attachment.bytes > 0 && attachment.bytes <= 8388608 &&
            attachment.width is int && attachment.width > 0 && attachment.width <= 12000 &&
            attachment.height is int && attachment.height > 0 && attachment.height <= 12000;
        }

        function validStickerMessage() {
          let sticker = request.resource.data.sticker;
          return sticker is map &&
            sticker.keys().hasOnly(['type', 'stickerId']) &&
            sticker.type == 'sticker' &&
            sticker.stickerId in [
              'happy-cat', 'love-birds', 'you-got-this', 'thank-you',
              'oops', 'thinking', 'study-mode', 'found-it',
              'coffee-break', 'good-luck', 'wave-hello', 'celebrate'
            ];
        }

        function validGifMessage() {
          let gif = request.resource.data.gif;
          return gif is map &&
            gif.keys().hasOnly(['type', 'provider', 'gifId']) &&
            gif.type == 'gif' &&
            gif.provider == 'giphy' &&
            gif.gifId is string && gif.gifId.matches('[A-Za-z0-9_-]{1,128}');
        }

        allow read: if isParentParticipant();
        allow create: if isParentParticipant() && !isBlockedBetweenParticipants() &&
          request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'content', 'timestamp',
            'read', 'status', 'readBy', 'attachment', 'sticker', 'gif'
          ]) &&
          (!('attachment' in request.resource.data) || validImageAttachment()) &&
          (!('sticker' in request.resource.data) || validStickerMessage()) &&
          (!('gif' in request.resource.data) || validGifMessage()) &&
          !('attachment' in request.resource.data && 'sticker' in request.resource.data) &&
          !('attachment' in request.resource.data && 'gif' in request.resource.data) &&
          !('sticker' in request.resource.data && 'gif' in request.resource.data) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderName is string &&
          request.resource.data.senderName.size() <= 100 &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 4000 &&
          request.resource.data.timestamp == request.time &&
          request.resource.data.read == false &&
          request.resource.data.status == 'sent' &&
          request.resource.data.readBy is map &&
          request.resource.data.readBy.keys().size() == 0;
        function validReactionUpdate() {
          let oldReactions = resource.data.get('reactions', {});
          let newReactions = request.resource.data.get('reactions', {});
          let changedUsers = newReactions.diff(oldReactions).affectedKeys();
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
            changedUsers.size() == 1 &&
            changedUsers.hasOnly([request.auth.uid]) &&
            (
              (
                request.auth.uid in newReactions &&
                newReactions[request.auth.uid] is string &&
                newReactions[request.auth.uid].size() > 0 &&
                newReactions[request.auth.uid].size() <= 64
              ) ||
              (
                !(request.auth.uid in newReactions) &&
                request.auth.uid in oldReactions
              )
            );
        }

        allow update: if isParentParticipant() && (
          (
            resource.data.senderId != request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'read', 'status', 'readBy'
            ]) &&
            request.resource.data.read == true &&
            request.resource.data.status == 'read' &&
            request.resource.data.readBy.diff(resource.data.readBy)
              .affectedKeys().hasOnly([request.auth.uid]) &&
            request.resource.data.readBy.diff(resource.data.readBy)
              .addedKeys().hasOnly([request.auth.uid]) &&
            request.resource.data.readBy[request.auth.uid] == request.time
          ) ||
          validReactionUpdate()
        );
        allow delete: if false;
      }
    }

    match /adminSettings/{document} {
      allow read, write: if isAdmin();
    }
  }
}
